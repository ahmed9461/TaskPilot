[Unit]
Description=TaskPilot isolated personal pilot API
After=network.target docker.service
Requires=docker.service
[Service]
Type=simple
User=taskpilot
Group=taskpilot
WorkingDirectory=/opt/taskpilot/current
EnvironmentFile=/etc/taskpilot/pilot.env
ExecStart=/usr/bin/node dist/services/api/src/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
# libsignal has direct console calls that can include session key objects.
# Diagnostics use redacted database events/health; never persist provider stdout/stderr.
StandardOutput=null
StandardError=null
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/taskpilot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=384M
CPUQuota=50%
TasksMax=64
[Install]
WantedBy=multi-user.target
