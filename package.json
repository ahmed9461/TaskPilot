{
  "name": "taskpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/services/api/src/main.js",
    "migrate": "tsx services/api/src/migrate.ts",
    "test": "tsx --test services/api/test/*.test.ts",
    "test:integration": "tsx --test services/api/test/integration/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "tsx": "4.23.15",
    "typescript": "6.0.2"
  }
}
