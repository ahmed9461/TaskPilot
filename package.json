{
  "name": "taskpilot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/services/api/src/main.js",
    "migrate": "tsx services/api/src/migrate.ts",
    "test": "tsx --test services/api/test/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 services/api/test/integration/*.test.ts",
    "check": "npm run build && npm test",
    "secrets": "node scripts/check-repository.mjs",
    "format:check": "prettier --check \"services/**/*.ts\" \"packages/**/*.ts\" \"scripts/*.mjs\" \"ops/*.mjs\""
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "baileys": "7.0.0-rc14",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "prettier": "3.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2"
  }
}
