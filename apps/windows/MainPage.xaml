<Page x:Class="TaskPilot_Windows.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Page.Resources>
  <DataTemplate x:Key="WrappedNavigationLabel"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
 </Page.Resources>
 <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <NavigationView x:Name="Nav" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" SelectionChanged="Navigate" OpenPaneLength="232" AlwaysShowHeader="False">
   <NavigationView.MenuItems>
    <NavigationViewItemHeader Content="TaskPilot"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="لوحة التحكم" Tag="dashboard" Icon="Home" IsSelected="True"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="صندوق المراجعة" Tag="inbox" Icon="Mail"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="الحسابات" Tag="accounts" Icon="People"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="المهام" Tag="assignments" Icon="AllApps"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="الردود والقوالب" Tag="replies" Icon="Message"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="المجموعات" Tag="groups" Icon="World"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="الجلسات" Tag="sessions" Icon="Link"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" x:Name="NotificationsNav" Content="الإشعارات" Tag="notifications" Icon="Flag"><NavigationViewItem.InfoBadge><InfoBadge x:Name="UnreadBadge" Value="0" Visibility="Collapsed"/></NavigationViewItem.InfoBadge></NavigationViewItem>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="سجل النشاط" Tag="audit" Icon="List"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="الذكاء الاصطناعي" Tag="ai" Icon="Help"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="المراقبة" Tag="operations" Icon="View"/>
    <NavigationViewItem ContentTemplate="{StaticResource WrappedNavigationLabel}" Content="الخصوصية والاحتفاظ" Tag="privacy" Icon="Delete"/>
   </NavigationView.MenuItems>
   <Grid Padding="32,24">
    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
     <StackPanel Spacing="20">
      <StackPanel Spacing="6"><TextBlock x:Name="Heading" Text="لوحة التحكم" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1"/><TextBlock Text="نسخة شخصية تجريبية" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></StackPanel>
      <InfoBar x:Name="Connection" IsOpen="True" IsClosable="False" Severity="Informational" Title="الاتصال" Message="أدخل بيانات الاتصال من الإعدادات للبدء."><InfoBar.ActionButton><Button x:Name="ReconnectButton" Content="إعادة الاتصال" Click="Reconnect_Click" Visibility="Collapsed"/></InfoBar.ActionButton></InfoBar>
      <StackPanel x:Name="Body" Spacing="14" Padding="0,0,0,24"/>
     </StackPanel>
    </ScrollViewer>
    <ProgressRing x:Name="BusyIndicator" Width="26" Height="26" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
   </Grid>
  </NavigationView>
 </Grid>
</Page>
