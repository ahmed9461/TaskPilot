<Page x:Class="TaskPilot_Windows.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <NavigationView x:Name="Nav" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" SelectionChanged="Navigate" OpenPaneLength="232" AlwaysShowHeader="False">
   <NavigationView.MenuItems>
    <NavigationViewItemHeader Content="TaskPilot"/>
    <NavigationViewItem x:Name="DashboardNav" AutomationProperties.Name="لوحة التحكم" Tag="dashboard" Icon="Home" IsSelected="True"><NavigationViewItem.Content><TextBlock Text="لوحة التحكم" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="صندوق المراجعة" Tag="inbox" Icon="Mail"><NavigationViewItem.Content><TextBlock Text="صندوق المراجعة" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="الحسابات" Tag="accounts" Icon="People"><NavigationViewItem.Content><TextBlock Text="الحسابات" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="المهام" Tag="assignments" Icon="AllApps"><NavigationViewItem.Content><TextBlock Text="المهام" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="المساعد الشخصي" Tag="assistant" Icon="Contact"><NavigationViewItem.Content><TextBlock Text="المساعد الشخصي" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="الردود والقوالب" Tag="replies" Icon="Message"><NavigationViewItem.Content><TextBlock Text="الردود والقوالب" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="المجموعات" Tag="groups" Icon="World"><NavigationViewItem.Content><TextBlock Text="المجموعات" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="الجلسات" Tag="sessions" Icon="Link"><NavigationViewItem.Content><TextBlock Text="الجلسات" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem x:Name="NotificationsNav" AutomationProperties.Name="الإشعارات" Tag="notifications"><NavigationViewItem.Icon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA8F;"/></NavigationViewItem.Icon><NavigationViewItem.Content><TextBlock Text="الإشعارات" TextWrapping="Wrap"/></NavigationViewItem.Content><NavigationViewItem.InfoBadge><InfoBadge x:Name="UnreadBadge" Value="0" Visibility="Collapsed"/></NavigationViewItem.InfoBadge></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="سجل النشاط" Tag="audit" Icon="List"><NavigationViewItem.Content><TextBlock Text="سجل النشاط" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="إعدادات الذكاء الاصطناعي" Tag="ai" Icon="Help"><NavigationViewItem.Content><TextBlock Text="إعدادات الذكاء الاصطناعي" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="المراقبة" Tag="operations" Icon="View"><NavigationViewItem.Content><TextBlock Text="المراقبة" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
    <NavigationViewItem AutomationProperties.Name="الخصوصية والاحتفاظ" Tag="privacy" Icon="Delete"><NavigationViewItem.Content><TextBlock Text="الخصوصية والاحتفاظ" TextWrapping="Wrap"/></NavigationViewItem.Content></NavigationViewItem>
   </NavigationView.MenuItems>
   <Grid Padding="32,24">
    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
     <StackPanel Spacing="20">
      <StackPanel x:Name="PageIntro" Spacing="6"><TextBlock x:Name="Heading" Text="لوحة التحكم" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1"/><TextBlock Text="TaskPilot • النسخة الشخصية" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></StackPanel>
      <InfoBar x:Name="Connection" IsOpen="True" IsClosable="False" Severity="Informational" Title="الاتصال" Message="أدخل بيانات الاتصال من الإعدادات للبدء."><InfoBar.ActionButton><Button x:Name="ReconnectButton" Content="إعادة الاتصال" Click="Reconnect_Click" Visibility="Collapsed"/></InfoBar.ActionButton></InfoBar>
      <StackPanel x:Name="Body" Spacing="14" Padding="0,0,0,24"/>
     </StackPanel>
    </ScrollViewer>
    <ProgressRing x:Name="BusyIndicator" Width="26" Height="26" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
   </Grid>
  </NavigationView>
 </Grid>
</Page>
