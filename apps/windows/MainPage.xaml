<Page x:Class="TaskPilot_Windows.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" SelectionChanged="Navigate" OpenPaneLength="232" AlwaysShowHeader="False">
   <NavigationView.PaneHeader><StackPanel Margin="20,24" Spacing="6"><TextBlock Text="TaskPilot" FontSize="28" FontWeight="SemiBold" FlowDirection="LeftToRight"/><TextBlock Text="مساحة إدارة العمل" Opacity="0.65"/></StackPanel></NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="لوحة التحكم" Tag="dashboard" Icon="Home" IsSelected="True"/>
    <NavigationViewItem Content="صندوق المراجعة" Tag="inbox" Icon="Mail"/>
    <NavigationViewItem Content="الحسابات" Tag="accounts" Icon="People"/>
    <NavigationViewItem Content="المهام" Tag="assignments" Icon="AllApps"/>
    <NavigationViewItem Content="الردود والقوالب" Tag="replies" Icon="Message"/>
    <NavigationViewItem Content="المجموعات" Tag="groups" Icon="World"/>
    <NavigationViewItem Content="الجلسات" Tag="sessions" Icon="Link"/>
    <NavigationViewItem x:Name="NotificationsNav" Content="الإشعارات" Tag="notifications" Icon="Flag"><NavigationViewItem.InfoBadge><InfoBadge x:Name="UnreadBadge" Value="0" Visibility="Collapsed"/></NavigationViewItem.InfoBadge></NavigationViewItem>
    <NavigationViewItem Content="سجل النشاط" Tag="audit" Icon="List"/>
    <NavigationViewItem Content="الذكاء الاصطناعي" Tag="ai" Icon="Help"/>
    <NavigationViewItem Content="المراقبة" Tag="operations" Icon="View"/>
    <NavigationViewItem Content="الخصوصية والاحتفاظ" Tag="privacy" Icon="Delete"/>
   </NavigationView.MenuItems>
   <Grid Padding="32,24" RowSpacing="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="6"><TextBlock x:Name="Heading" Text="لوحة التحكم" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="نسخة شخصية تجريبية" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></StackPanel>
    <InfoBar Grid.Row="1" x:Name="Connection" IsOpen="True" IsClosable="False" Severity="Informational" Title="الاتصال" Message="أدخل بيانات الاتصال من الإعدادات للبدء."><InfoBar.ActionButton><Button x:Name="ReconnectButton" Content="إعادة الاتصال" Click="Reconnect_Click" Visibility="Collapsed"/></InfoBar.ActionButton></InfoBar>
    <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Body" Spacing="14" Padding="0,0,0,24"/></ScrollViewer>
    <ProgressRing x:Name="BusyIndicator" Grid.Row="2" Width="26" Height="26" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
   </Grid>
  </NavigationView>
 </Grid>
</Page>
