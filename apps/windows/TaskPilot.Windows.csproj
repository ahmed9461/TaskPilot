<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <Version>0.6.0</Version><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework><TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
  <RootNamespace>TaskPilot_Windows</RootNamespace><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
  <UseWinUI>true</UseWinUI><WinUISDKReferences>false</WinUISDKReferences><WindowsPackageType>None</WindowsPackageType><EnableMsixTooling>false</EnableMsixTooling>
  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  <PublishTrimmed>false</PublishTrimmed><PublishReadyToRun>false</PublishReadyToRun><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
 </PropertyGroup>
 <ItemGroup><Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
 <ItemGroup><PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957"/><PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5"/></ItemGroup>
 <!-- Unpackaged MRT Core currently generates these resources without adding them to publish. -->
 <Target Name="PublishTaskPilotXamlResources" BeforeTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="$(GenerateProjectPriFile)">
  <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="TaskPilot app PRI is required for portable publication." />
  <ItemGroup>
   <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" />
   <_TaskPilotXbf Include="$(TargetDir)**\*.xbf" />
   <ResolvedFileToPublish Include="@(_TaskPilotXbf)">
    <RelativePath>%(_TaskPilotXbf.RecursiveDir)%(_TaskPilotXbf.Filename)%(_TaskPilotXbf.Extension)</RelativePath>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
   </ResolvedFileToPublish>
  </ItemGroup>
 </Target>
</Project>
