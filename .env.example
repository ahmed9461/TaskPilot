# TEMPLATE ONLY. Never put real values here or commit a filled .env.
NODE_ENV=development
TASKPILOT_BIND_HOST=127.0.0.1
TASKPILOT_BIND_PORT=8240
DATABASE_URL=postgresql://taskpilot:CHANGE_ME@127.0.0.1:5432/taskpilot
# Runtime secret references must be provided securely outside Git.
TASKPILOT_ENCRYPTION_KEY_FILE=/etc/taskpilot/encryption-key
TASKPILOT_API_TOKEN_FILE=/etc/taskpilot/api-token
TASKPILOT_REAUTH_SECRET_FILE=/etc/taskpilot/reauth-secret
TASKPILOT_MOCK_ENABLED=true
# AI gates/model/limits are owner-versioned DB settings, disabled by default.
DEEPSEEK_API_KEY_FILE=/etc/taskpilot/deepseek-key
OPENROUTER_API_KEY_FILE=/etc/taskpilot/openrouter-key
# Outbound sending stays off until authorized integration tests.
WHATSAPP_CONNECTION_ENABLED=false
WHATSAPP_SENDING_ENABLED=false
